# ==========================================
# Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha suas credenciais
# ==========================================

# Configurações do MySQL (Docker)
MYSQL_DATABASE=finance_db
MYSQL_USER=finance_user
MYSQL_PASSWORD=sua_senha_segura
MYSQL_ROOT_PASSWORD=sua_senha_root_segura
MYSQL_PORT=3306

# Configurações de Conexão da Aplicação Spring Boot
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_db
DB_USER=finance_user
DB_PASSWORD=sua_senha_segura

# Autenticação e Segurança (JWT)
JWT_SECRET=sua_chave_secreta_jwt_min_256_bits
JWT_EXPIRATION=86400000

# Configurações de Envio de E-mail (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# URL Base da Aplicação (usada na geração de links nos e-mails)
APP_URL=http://localhost:8080

# Origens permitidas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173

# Rate Limiting em rotas públicas (/auth/** e POST /users)
RATE_LIMIT_ENABLED=true
# Só ative true se a API rodar atrás de proxy reverso confiável (Nginx/Cloudflare) com porta direta bloqueada
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_VERIFICATION_MAX_REQUESTS=10
RATE_LIMIT_EMAIL_DISPATCH_MAX_REQUESTS=5

# Higiene de Logs, Debug SQL e Swagger em Produção (padrões já são seguros para produção)
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
LOG_HIBERNATE_SQL=warn
LOG_HIBERNATE_BIND=warn
JACKSON_INDENT_OUTPUT=false
# Recomendado definir false ao publicar na internet para não expor documentação da API
SWAGGER_ENABLED=true

